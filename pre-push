#!/bin/sh
# git-attribution-hooks: pre-push
#
# Refuses to push unsigned commits to a protected branch. Agents can commit
# and push freely to feature branches -- that is how the work reaches a pull
# request for you to read -- but nothing unsigned lands on main.
#
# Reads "<local ref> <local oid> <remote ref> <remote oid>" on stdin.
#
#   attribution.push.protect          branch names, space separated
#                                     (default: "main master trunk")
#   attribution.push.requireSignoff   false to disable entirely
#
# NOTE: `git push --no-verify` skips this hook, as it skips every pre-push
# hook. This is a guardrail against the mistake, not a sandbox. Pair it with a
# server-side DCO check for anything you actually need enforced.
#
# https://github.com/kirkbrauer/git-attribution-hooks

set -e

remote="${1:-origin}"

require="$(git config --get attribution.push.requireSignoff 2>/dev/null || echo true)"
case "$require" in false|no|off|0) exit 0 ;; esac
case "$(git config --get attribution.signoff 2>/dev/null || echo human)" in
off) exit 0 ;;
esac

email="$(git config --get user.email 2>/dev/null || true)"
if [ -z "$email" ]; then
	echo "pre-push: user.email is not set, cannot verify sign-off" >&2
	exit 1
fi

protected="$(git config --get attribution.push.protect 2>/dev/null || echo 'main master trunk')"

is_protected() {
	_branch="${1#refs/heads/}"
	[ "$_branch" = "$1" ] && return 1		# not a branch ref (tag, note...)
	for _p in $protected; do
		# shellcheck disable=SC2254
		case "$_branch" in $_p) return 0 ;; esac
	done
	return 1
}

require_sig=0
case "$(git config --get attribution.push.requireSignature 2>/dev/null || echo false)" in
true|yes|on|1) require_sig=1 ;;
esac

unsigned=""
count=0
loose=0
unsigned_sig=""
sigcount=0

while read -r _local_ref local_oid remote_ref remote_oid; do
	[ -n "$local_oid" ] || continue
	case "$local_oid" in *[!0]*) ;; *) continue ;; esac	# branch deletion

	case "$remote_oid" in
	*[!0]*) range="$(git rev-list "$remote_oid..$local_oid" 2>/dev/null || true)" ;;
	# New branch: everything not already somewhere on this remote.
	*)      range="$(git rev-list "$local_oid" --not --remotes="$remote" 2>/dev/null || true)" ;;
	esac

	for sha in $range; do
		# Merge commits carry no sign-off by design; skip them.
		parents="$(git show -s --format=%P "$sha" 2>/dev/null || true)"
		case "$parents" in *' '*) continue ;; esac
		if git show -s --format=%B "$sha" |
		   grep -qiE "^Signed-off-by:.*<$(printf '%s' "$email" | sed 's/[].[^$*\/]/\\&/g')>[[:space:]]*$"; then
			continue
		fi
		if [ "$require_sig" = "1" ]; then
			case "$(git log -1 --format='%G?' "$sha" 2>/dev/null || echo N)" in
			G|U) ;;
			*) unsigned_sig="$unsigned_sig $sha"; sigcount=$((sigcount + 1)) ;;
			esac
		fi
		if is_protected "$remote_ref"; then
			unsigned="$unsigned $sha"
			count=$((count + 1))
		else
			loose=$((loose + 1))
		fi
	done
done

if [ "$sigcount" -gt 0 ]; then
	echo >&2
	echo "push rejected: $sigcount commit(s) carry no valid signature" >&2
	echo >&2
	for sha in $unsigned_sig; do
		git show -s --format='    %h %s' "$sha" >&2
	done
	echo >&2
	echo "Sign them while you certify them:" >&2
	echo >&2
	echo "    git signoff" >&2
	echo >&2
	echo "Disable with: git config attribution.push.requireSignature false" >&2
	echo >&2
	exit 1
fi

if [ "$count" -eq 0 ]; then
	if [ "$loose" -gt 0 ]; then
		echo >&2
		echo "note: pushing $loose unsigned commit(s) to an unprotected branch." >&2
		echo "      Review them there, then run 'git signoff' before they merge." >&2
		echo >&2
	fi
	exit 0
fi

echo >&2
echo "push rejected: $count commit(s) bound for a protected branch have no" >&2
echo "Signed-off-by for <$email>" >&2
echo >&2
for sha in $unsigned; do
	git show -s --format='    %h %s' "$sha" >&2
done
echo >&2
echo "Review them, then certify:" >&2
echo >&2
echo "    git signoff              # shows the diff, asks you to confirm" >&2
echo >&2
echo "Or, if you prefer to do it by hand:" >&2
echo >&2
echo "    git rebase --signoff $remote/\$(git rev-parse --abbrev-ref HEAD)" >&2
echo >&2
exit 1
