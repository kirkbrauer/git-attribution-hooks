#!/bin/sh
# git-attribution-hooks: prepare-commit-msg
#
# Rewrites AI coding agents' GitHub-style co-author trailers into the Linux
# kernel's AI-assistance format (Documentation/process/coding-assistants.rst):
#
#   Assisted-by: AGENT_NAME:MODEL_VERSION [TOOL1] [TOOL2]
#
#   Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
#     ->  Assisted-by: Claude:claude-opus-5
#   Co-authored-by: aider (gpt-4o) <aider@aider.chat>
#     ->  Assisted-by: aider:gpt-4o
#   Co-authored-by: Codex <noreply@openai.com>
#     ->  Assisted-by: Codex
#
# No optional tools are listed: the kernel reserves that field for specialised
# analysis tools (coccinelle, sparse), not the agent or editor.
#
# Then adds a DCO Signed-off-by built from the identity git resolves for the
# current repo, so a repo-local user.email wins over the global one. The kernel
# is explicit that only a human may certify the DCO -- this trailer is
# generated locally from your git identity, never written by an agent.
#
# Co-author trailers that match no known agent are left untouched, so human
# co-authors keep their credit.
#
# Configuration (all optional, any git config scope):
#
#   attribution.<agent>.model   MODEL_VERSION to use when the trailer carries
#                               no model, e.g.
#                                 git config --global attribution.codex.model gpt-5.1-codex
#   attribution.<agent>.match   extended regex matched against the lowercased
#                               trailer address; registers a new agent or
#                               overrides a built-in one
#   attribution.<agent>.name    AGENT_NAME to print (default: <agent>
#                               capitalised)
#
# https://github.com/kirkbrauer/git-attribution-hooks

set -e

msg_file="$1"
commit_source="$2"

# A global core.hooksPath hides each repo's own .git/hooks, so run any
# repo-local hook first and honour its exit status. Resolve it from --git-dir,
# not `--git-path hooks/...`: the latter honours core.hooksPath and so would
# just point back at this file.
git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
repo_hook="${git_dir:+$git_dir/hooks/prepare-commit-msg}"
if [ -n "$repo_hook" ] && [ -x "$repo_hook" ] &&
   [ "$(cd "$(dirname "$repo_hook")" && pwd)/$(basename "$repo_hook")" != \
     "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" ]; then
	"$repo_hook" "$@" || exit $?
fi

# Merge commit messages are generated by git; leave them untouched.
[ "$commit_source" = "merge" ] && exit 0

overrides="$(git config --get-regexp '^attribution\..+\.(model|match|name)$' 2>/dev/null || true)"

tmp="$msg_file.attr$$"
awk -v overrides="$overrides" '
	# Lowercase, spaces to hyphens, drop anything not safe in a trailer word.
	function slug(s) {
		s = tolower(s)
		gsub(/[ \t]+/, "-", s)
		gsub(/[^a-z0-9._+-]/, "", s)
		return s
	}
	BEGIN {
		# Built-in agents, keyed by a regex matched against the lowercased
		# address. mode says where to find the model version in the display
		# name: "strip" = the name minus any trailing parenthetical (Claude
		# says "Claude Opus 5 (1M context)"), "paren" = inside the
		# parentheses (aider says "aider (gpt-4o)"), "none" = not carried.
		n = 0
		add("claude",  "@anthropic\\.com$",                       "Claude",  "strip")
		add("codex",   "@openai\\.com$",                          "Codex",   "none")
		add("copilot", "copilot(\\[bot\\])?@users\\.noreply\\.github\\.com$", "Copilot", "none")
		add("cursor",  "@cursor\\.com$",                          "Cursor",  "none")
		add("aider",   "@aider\\.chat$",                          "aider",   "paren")

		# Apply git config. Later keys override the built-in table and can
		# register agents it does not know about.
		split(overrides, lines, "\n")
		for (i in lines) {
			if (lines[i] == "") continue
			key = lines[i]
			sub(/[ \t].*$/, "", key)
			val = lines[i]
			sub(/^[^ \t]*[ \t]+/, "", val)
			if (val == "" || key == lines[i]) continue
			split(key, parts, ".")
			agent = parts[2]
			field = parts[3]
			if (agent == "" || field == "") continue
			if (!(agent in idx)) {
				add(agent, "", toupper(substr(agent,1,1)) substr(agent,2), "strip")
			}
			j = idx[agent]
			if (field == "model") model_cfg[j] = val
			else if (field == "match") pattern[j] = val
			else if (field == "name")  display[j] = val
		}
	}
	function add(agent, re, disp, m) {
		n++
		idx[agent] = n
		pattern[n] = re
		display[n] = disp
		mode[n] = m
		return n
	}
	/^[Cc]o-[Aa]uthored-[Bb]y:[ \t]/ {
		rest = $0
		sub(/^[Cc]o-[Aa]uthored-[Bb]y:[ \t]*/, "", rest)
		if (!match(rest, /<[^>]*>[ \t]*$/)) { print; next }
		email = tolower(substr(rest, RSTART + 1, RLENGTH - 2))
		sub(/[ \t]+$/, "", email)
		name = substr(rest, 1, RSTART - 1)
		sub(/[ \t]+$/, "", name)

		hit = 0
		for (k = 1; k <= n; k++)
			if (pattern[k] != "" && email ~ pattern[k]) { hit = k; break }
		if (!hit) { print; next }		# human co-author

		agent_name = display[hit]
		model = ""
		if (mode[hit] == "strip") {
			bare = name
			sub(/[ \t]*\(.*\)[ \t]*$/, "", bare)
			sub(/[ \t]+$/, "", bare)
			# A single-word name is just the agent ("Claude", "Robo"); only
			# a qualified one ("Claude Opus 5") names a model.
			if (bare ~ /[ \t]/) model = slug(bare)
		} else if (mode[hit] == "paren" && match(name, /\([^)]*\)/)) {
			model = slug(substr(name, RSTART + 1, RLENGTH - 2))
		}
		if (model == "") model = slug(model_cfg[hit])
		# A "model" identical to the agent name carries no information.
		if (model == "" || model == slug(agent_name))
			print "Assisted-by: " agent_name
		else
			print "Assisted-by: " agent_name ":" model
		next
	}
	{ print }
' "$msg_file" >"$tmp"
cat "$tmp" >"$msg_file"
rm -f "$tmp"

# GIT_AUTHOR_IDENT is "Name <email> <timestamp> <tz>"; keep everything through
# the closing chevron. The DCO requires a real name and address.
ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
[ -n "$ident" ] || exit 0
signer="$(printf '%s' "$ident" | sed -E 's/^(.*<[^>]*>).*$/\1/')"

# Is a coding agent driving this commit? Every one of these is set by the tool
# itself, not by the shell, so it survives into hooks.
agent_session() {
	[ -n "${GIT_ATTRIBUTION_AGENT:-}" ] ||
	[ -n "${AI_AGENT:-}" ] ||
	[ -n "${CLAUDECODE:-}" ] ||
	[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] ||
	[ -n "${CODEX_SANDBOX:-}" ] ||
	[ -n "${CODEX_SESSION_ID:-}" ] ||
	[ -n "${CURSOR_AGENT:-}" ] ||
	[ -n "${COPILOT_AGENT:-}" ] ||
	[ -n "${AIDER_CHAT:-}" ]
}

# attribution.signoff: auto (default) | human | off
#   auto  -- always sign, whoever is committing. Review locally before you
#            push; nothing here enforces that for you.
#   human -- never sign an agent's commit. They arrive unsigned and you
#            certify them afterwards with `git signoff`, which rewrites them.
#   off   -- never sign
policy="$(git config --get attribution.signoff 2>/dev/null || echo auto)"

case "$policy" in
off)
	exit 0 ;;
auto)
	;;
*)
	if agent_session; then
		# Do not certify the DCO on the human's behalf for work they have not
		# read. Also drop a sign-off in their name that the agent wrote into
		# the message itself, which would otherwise sail straight through.
		esc="$(printf '%s' "$signer" | sed -e 's/[][\\.^$*/]/\\&/g')"
		sed -i.attrbak -E "/^Signed-off-by:[[:space:]]*$esc[[:space:]]*$/d" "$msg_file"
		rm -f "$msg_file.attrbak"
		exit 0
	fi ;;
esac

git interpret-trailers --in-place --if-exists doNothing \
	--trailer "Signed-off-by: $signer" "$msg_file"
